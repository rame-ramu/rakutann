{
  "name": "text",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:data": "run-s generate:curriculum generate:syllabus-urls audit:attributes generate:attributes",
    "generate:curriculum": "node scripts/generate-curriculum-data.mjs",
    "audit:attributes": "node scripts/audit-student-attributes.mjs",
    "generate:attributes": "node scripts/generate-student-attribute-data.mjs",
    "generate:syllabus-urls": "node scripts/generate-syllabus-urls.mjs",
    "validate:data": "node scripts/validate-generated-data.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "run-s test:unit test:firestore",
    "test:unit": "run-s test:unit:profile test:unit:attributes test:unit:presentation test:unit:urls test:unit:eligibility",
    "test:unit:profile": "vitest run src/services/__tests__/studentProfile.spec.ts --pool=threads --maxWorkers=1",
    "test:unit:attributes": "vitest run src/services/__tests__/studentAttributes.spec.ts --pool=threads --maxWorkers=1",
    "test:unit:presentation": "vitest run src/services/__tests__/coursePresentation.spec.ts --pool=threads --maxWorkers=1",
    "test:unit:urls": "vitest run src/services/__tests__/syllabusUrls.spec.ts --pool=threads --maxWorkers=1",
    "test:unit:eligibility": "vitest run src/services/__tests__/eligibilityEngine.spec.ts --pool=threads --maxWorkers=1",
    "test:firestore": "firebase emulators:exec --config ../firebase.json --project demo-rakutann-friends --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase": "^12.17.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "exceljs": "^4.4.0",
    "firebase-tools": "^15.28.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "pdfjs-dist": "^6.2.108",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
