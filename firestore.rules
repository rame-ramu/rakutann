rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isFriend(userId, friendId) {
      return exists(/databases/$(database)/documents/friends/$(userId)/members/$(friendId));
    }

    function canReadFriendEdge(userId, friendId) {
      return request.auth.uid == userId
        || request.auth.uid == friendId
        || (isFriend(request.auth.uid, userId) && isFriend(request.auth.uid, friendId));
    }

    function canReadProfile(userId) {
      return request.auth.uid == userId
        || isFriend(request.auth.uid, userId)
        || exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid)/requests/$(userId))
        || exists(/databases/$(database)/documents/friendRequests/$(userId)/requests/$(request.auth.uid));
    }

    function validFriendAcceptance(userId, friendId) {
      return userId != friendId
        && request.resource.data.keys().hasOnly([
          'userId',
          'friendUid',
          'acceptedBy',
          'requestedBy',
          'acceptedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.friendUid == friendId
        && request.resource.data.acceptedBy == request.auth.uid
        && (
          (userId == request.auth.uid && friendId == request.resource.data.requestedBy)
          || (friendId == request.auth.uid && userId == request.resource.data.requestedBy)
        )
        && exists(
          /databases/$(database)/documents/friendRequests/$(request.auth.uid)/requests/$(request.resource.data.requestedBy)
        )
        && getAfter(
          /databases/$(database)/documents/friends/$(friendId)/members/$(userId)
        ).data.userId == friendId
        && getAfter(
          /databases/$(database)/documents/friends/$(friendId)/members/$(userId)
        ).data.friendUid == userId;
    }

    function validMemoMembers(memberIds) {
      return memberIds is list
        && memberIds.size() >= 2
        && memberIds.size() <= 5
        && memberIds.toSet().size() == memberIds.size();
    }

    function allMemoMembersAreFriends(memberIds) {
      return (
        memberIds.size() == 2
        && isFriend(memberIds[0], memberIds[1])
      ) || (
        memberIds.size() == 3
        && isFriend(memberIds[0], memberIds[1])
        && isFriend(memberIds[0], memberIds[2])
        && isFriend(memberIds[1], memberIds[2])
      ) || (
        memberIds.size() == 4
        && isFriend(memberIds[0], memberIds[1])
        && isFriend(memberIds[0], memberIds[2])
        && isFriend(memberIds[0], memberIds[3])
        && isFriend(memberIds[1], memberIds[2])
        && isFriend(memberIds[1], memberIds[3])
        && isFriend(memberIds[2], memberIds[3])
      ) || (
        memberIds.size() == 5
        && isFriend(memberIds[0], memberIds[1])
        && isFriend(memberIds[0], memberIds[2])
        && isFriend(memberIds[0], memberIds[3])
        && isFriend(memberIds[0], memberIds[4])
        && isFriend(memberIds[1], memberIds[2])
        && isFriend(memberIds[1], memberIds[3])
        && isFriend(memberIds[1], memberIds[4])
        && isFriend(memberIds[2], memberIds[3])
        && isFriend(memberIds[2], memberIds[4])
        && isFriend(memberIds[3], memberIds[4])
      );
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && canReadProfile(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'friendCode',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() == 8
        && getAfter(
          /databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)
        ).data.ownerUid == userId;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string;
      allow delete: if false;
    }

    match /friendCodes/{friendCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['code', 'ownerUid', 'createdAt'])
        && request.resource.data.code == friendCode
        && friendCode.size() == 8
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/profiles/$(request.auth.uid)
        ).data.friendCode == friendCode;
      allow update, delete: if false;
    }

    match /friendRequests/{receiverUid}/requests/{senderUid} {
      allow get: if isSignedIn()
        && (request.auth.uid == receiverUid || request.auth.uid == senderUid);
      allow list: if isSignedIn() && request.auth.uid == receiverUid;
      allow create: if isSignedIn()
        && request.auth.uid == senderUid
        && senderUid != receiverUid
        && !isFriend(senderUid, receiverUid)
        && request.resource.data.keys().hasOnly([
          'senderUid',
          'receiverUid',
          'status',
          'createdAt'
        ])
        && request.resource.data.senderUid == senderUid
        && request.resource.data.receiverUid == receiverUid
        && request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if isSignedIn()
        && (request.auth.uid == receiverUid || request.auth.uid == senderUid);
    }

    match /friends/{userId}/members/{friendId} {
      allow get: if isSignedIn() && canReadFriendEdge(userId, friendId);
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && validFriendAcceptance(userId, friendId);
      allow update: if false;
      allow delete: if isSignedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId)
        && getAfter(
          /databases/$(database)/documents/friends/$(friendId)/members/$(userId)
        ) == null;
    }

    match /sharedSchedules/{userId}/years/{academicYear} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isFriend(userId, request.auth.uid));
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'academicYear',
          'courses',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == userId
        && request.resource.data.academicYear is int
        && request.resource.data.courses is list
        && request.resource.data.courses.size() <= 50;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /sharedMemoGroups/{groupId} {
      allow get: if isSignedIn()
        && validMemoMembers(resource.data.memberIds)
        && request.auth.uid in resource.data.memberIds
        && allMemoMembersAreFriends(resource.data.memberIds);
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'academicYear',
          'courseId',
          'courseName',
          'memberIds',
          'memo',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && validMemoMembers(request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && allMemoMembersAreFriends(request.resource.data.memberIds)
        && request.resource.data.academicYear is int
        && request.resource.data.courseId is string
        && request.resource.data.courseName is string
        && request.resource.data.memo == ''
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && validMemoMembers(resource.data.memberIds)
        && request.auth.uid in resource.data.memberIds
        && allMemoMembersAreFriends(resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memo', 'updatedAt'])
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 2000;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /memoMemberships/{userId}/groups/{groupId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'memberId', 'createdAt'])
        && request.resource.data.groupId == groupId
        && request.resource.data.memberId == userId
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/sharedMemoGroups/$(groupId)
        ).data.memberIds
        && userId in getAfter(
          /databases/$(database)/documents/sharedMemoGroups/$(groupId)
        ).data.memberIds;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
